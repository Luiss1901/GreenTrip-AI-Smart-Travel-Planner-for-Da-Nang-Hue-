# ==========================================
# GreenTrip AI - Environment Configuration
# ==========================================

# PostgreSQL / Supabase database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public client key
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only key
# Add this only when backend actually needs elevated Supabase access.
# Never expose it to frontend code.
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Neo4j Aura
# These values must be provided only in a local .env or Render secret environment.
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
